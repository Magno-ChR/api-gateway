{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "ServiceName": "api-gateway",
    "OtlpEndpoint": "http://165.22.148.216:4317"
  },
  "Loki": {
    "Uri": "http://165.22.148.216:3100"
  },
  "Consul": {
    "Host": "http://165.22.148.216:8500",
    "ServiceName": "api-gateway",
    "ServiceAddress": "167.71.109.119",
    "ServicePort": 5000,
    "Tags": [ "dotnet", "api", "gateway", "metrics" ],
    "HealthCheckEndpoint": "/health/live"
  },
  "ConsulDiscovery": {
    "Enabled": true,
    "RefreshSeconds": 30,
    "Clusters": {
      "security-api": "api-security",
      "patients-api": "api-patient",
      "kitchen-api": "ms-kitchen",
      "logistic-api": "ms-logistic",
      "calendar-api": "calendario-webapi",
      "plans-api": "ms-plans"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "security-api": {
        "ClusterId": "security-api",
        "Match": { "Path": "/api/security/{**catch-all}" }
      },
      "patients-api": {
        "ClusterId": "patients-api",
        "Match": { "Path": "/api/patient/{**catch-all}" }
      },
      "kitchen-api": {
        "ClusterId": "kitchen-api",
        "Match": { "Path": "/api/kitchen/{**catch-all}" }
      },
      "logistic-api": {
        "ClusterId": "logistic-api",
        "Match": { "Path": "/api/logistic/{**catch-all}" }
      },
      "plans-api": {
        "ClusterId": "plans-api",
        "Match": { "Path": "/api/plans/{**catch-all}" }
      },
      "calendar-api": {
        "ClusterId": "calendar-api",
        "Match": { "Path": "/api/calendario/{**catch-all}" }
      }
    },
    "Clusters": {
      "security-api": {
        "Destinations": {
          "security-backend": { "Address": "http://localhost:5001" }
        }
      },
      "patients-api": {
        "Destinations": {
          "patients-backend": { "Address": "http://localhost:5002" }
        }
      },
      "kitchen-api": {
        "Destinations": {
          "kitchen-backend": { "Address": "http://localhost:5005" }
        }
      },
      "logistic-api": {
        "Destinations": {
          "logistic-backend": { "Address": "http://localhost:5006" }
        }
      },
      "plans-api": {
        "Destinations": {
          "plans-backend": { "Address": "http://localhost:5007" }
        }
      },
      "calendar-api": {
        "Destinations": {
          "calendar-backend": { "Address": "http://calendario-webapi:7020" }
        }
      }
    }
  }
}
